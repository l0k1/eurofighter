<?xml version="1.0"?>

<!--
    fuel system notes have been taken from the DA7 flight manual

    props needed:
    systems/fuel/cg-ratio (0 is fore, 0.5 is centered, 1.0 is aft) use me to balance tanks on the fly
    systems/electric/left-booster
    systems/electric/right-booster
    systems/electric/transfer-boosters
    systems/fuel/pressure-flow
    systems/fuel/transfer-flow (-1 is towards aft, 0 is off, 1 is fore)
    systems/fuel/left-boost-pressure
    systems/fuel/right-boost-pressure
    systems/fuel/transfer-pressure
    systems/fuel/left-lpcock (bool, 0 is blocking, 1 is open)
    systems/fuel/right-lpcock (bool, 0 is blocking, 1 is open)
    systems/fuel/fore-transfer-valve (bool, 0 is blocking, 1 is open)
    systems/fuel/aft-transfer-valve (bool, 0 is blocking, 1 is open)
    systems/fuel/xfeed (bool, 0 is off)
    systems/fuel/interconnect-valve (bool, 0 is off)
-->

<!-- 
    tank list:
    0 - forward transfer - 2094
    1 - forward tank - 2094
    2 - aft tank - 1962
    3 - foreleft wing tank - 1089
    4 - aftleft wing tank - 1089
    5 - foreright wing tank - 1089
    6 - aftright wing tank - 1089
    7 - center drop tank
    8 - left drop tank
    9 - right drop tank
    10 - left accumulator - 2
    11 - right accumulator - 2
-->

<!--
    notes:
    apu is fed from forward tank
    there is both auto control and manual control of which auto mode, or moving fuel back/forward
    the five stages:
    1) left/right drop pods -> main fuselage tanks (UWG)
    2) central drop pod -> main fuselage tanks (UFUS)
    3) forward transfer tank and wing aft tank -> main fuselage tanks (stage 1 transfer) (STG1)
    4) forward wing tanks -> main fuselage tanks (stage 2 transfer) (STG2)
    5) main fuselage tanks

    by pressing XFER FWD or XFER REAR, the transfer valves for the unselected tank close, resulting in all fuel going to the selected tank



    todo:
    interconnect
    summers
-->

<system name="fuel">
    <channel name="fuelflow">

        <!-- calc fuel pressure -->
        <!-- pressure at higher speeds comes from ram air intake -->
        <fcs_function name="trash/systems/fuel/pressure-flow">
            <function>
                <interpolate1d>
                    <max>
                        <property>propulsion/engine[0]/n1</property>
                        <property>propulsion/engine[1]/n1</property>
                        <product>
                            <property>systems/apu/spinrate</property>
                            <value>30</value>
                        </product>
                        <product>
                            <property>velocities/mach</property>
                            <value>250</value>
                        </product>
                    </max>
                    <value> 0.0</value> <value> 0.0</value>
                    <value>30.0</value> <value>12.0</value>
                </interpolate1d>
            </function>
            <output>systems/fuel/pressure-flow</output>
        </fcs_function>
        
        <!-- calculate left and right booster pressure -->
        <fcs_function name="trash/systems/fuel/left-boost-pressure">
            <function>
                <quotient>
                    <table>
                        <independentVar lookup="row">systems/electric/left-booster</independentVar>
                        <tableData>
                            0.0         0.0
                            1.0     15.0
                        </tableData>
                    </table>
                    <sum>
                        <product>
                            <property>systems/fuel/right-lpcock</property>
                            <property>systems/fuel/xfeed</property>
                        </product>
                        <value>1</value>
                    </sum>
                </quotient>
            </function>
            <output>systems/fuel/left-boost-pressure</output>
        </fcs_function>
        
        
        <fcs_function name="trash/systems/fuel/right-boost-pressure">
            <function>
                <quotient>
                    <table>
                        <independentVar lookup="row">systems/electric/right-booster</independentVar>
                        <tableData>
                            0.0         0.0
                            1.0     15.0
                        </tableData>
                    </table>
                    <sum>
                        <product>
                            <property>systems/fuel/left-lpcock</property>
                            <property>systems/fuel/xfeed</property>
                        </product>
                        <value>1</value>
                    </sum>
                </quotient>
            </function>
            <output>systems/fuel/right-boost-pressure</output>
        </fcs_function>

        <!-- determine stage -->
        <fcs_function name="trash/systems/fuel/stage_calc">
            <!-- stages:
                0 = UWG
                1 = UFUS
                2 = STG1
                3 = STG2

                pseudocode

            if automode        
                if left/right drop tanks > 0 then:
                    stage UWG
                elif manu stage = 0 and ufus > 0 then
                    stage UFUS
                elif fwdtrans + wingaft > 0 then
                    stage STG1
                els
                    stage STG2
            else
                manual selection


                manual-mode-selection:
                0 = auto
                1 = UWG
                2 = UFUS
                3 = STG1
                4 = STG2
            -->
            <function>
                <ifthen>
                    <and>
                        <gt>
                            <sum>
                                <property>propulsion/tank[8]/contents-lbs</property>
                                <property>propulsion/tank[9]/contents-lbs</property>
                            </sum>
                            <value>10</value>
                        </gt>
                        <lt>
                            <property>systems/fuel/manual-mode-selection</property>
                            <value>2</value>
                        </lt>
                    </and>
                    <value>0</value>
                    <ifthen>
                        <and>
                            <gt>
                                <property>propulsion/tank[7]/contents-lbs</property>
                                <value>5</value>
                            </gt>
                            <lt>
                                <property>systems/fuel/manual-mode-selection</property>
                                <value>3</value>
                            </lt>
                        </and>
                        <value>1</value>
                        <ifthen>
                            <and>
                                <gt>
                                    <sum>
                                        <property>propulsion/tank[0]/contents-lbs</property>
                                        <property>propulsion/tank[4]/contents-lbs</property>
                                        <property>propulsion/tank[6]/contents-lbs</property>
                                    </sum>
                                    <value>10</value>
                                </gt>
                                <lt>
                                    <property>systems/fuel/manual-mode-selection</property>
                                    <value>4</value>
                                </lt>
                            </and>
                            <value>2</value>
                            <value>3</value>
                        </ifthen>
                    </ifthen>
                </ifthen>
            </function>
            <output>systems/fuel/stage_calc</output>
        </fcs_function>

        <!-- balancing logic -->
        <!-- because fuel tanks are all at CG right now, this will
            seek to balance fore and aft tanks. -->

        <fcs_function name="trash/systems/fuel/transfer-balance">
            <function>
                <ifthen>
                    <gt>
                        <difference>
                            <product>
                                <sum>
                                    <property>propulsion/tank[1]/contents-lbs</property>
                                    <property>propulsion/tank[2]/contents-lbs</property>
                                </sum>
                                <property>systems/fuel/cg-ratio</property>
                            </product>
                            <property>propulsion/tank[1]/contents-lbs</property>
                        </difference>
                        <value>0</value>
                    </gt>
                    <value>1</value>
                    <value>-1</value>
                </ifthen>
            </function>
            <output>systems/fuel/transfer-flow</output>
        </fcs_function>
            
        
        <fcs_function name="trash/systems/fuel/transfer-pressure">
            <function>
                <product>
                    <table>
                        <independentVar lookup="row">systems/electric/transfer-boosters</independentVar>
                        <tableData>
                            0.0         0.0
                            1.0     15.0
                        </tableData>
                    </table>
                    <value>-1</value>
                </product>
            </function>
            <output>systems/fuel/transfer-pressure</output>
        </fcs_function>

<!--
    FUEL USAGE
-->

        <!-- interconnect aft/mid -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/transfer-pressure">
                systems/fuel/interconnect-valve == 1
                propulsion/tank[2]/pct-full gt propulsion/tank[1]/pct-full
            </test>
            <output>propulsion/tank[1]/mid-to-aft-interc</output>
        </switch>

        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/transfer-pressure">
                systems/fuel/interconnect-valve == 1
                propulsion/tank[2]/pct-full lt propulsion/tank[1]/pct-full
            </test>
            <output>propulsion/tank[2]/aft-to-mid-interc</output>
        </switch>
            
        <!-- mid to accumulators -->
        <switch name="trash/propulsion/tank[1]/mid-to-left-acc">
            <default value="0"/>
            <test logic="AND" value="systems/fuel/left-boost-pressure">
                systems/fuel/left-lpcock == 1
                propulsion/tank[1]/pct-full gt 0.5
                propulsion/tank[10]/contents-lbs lt 1.0
            </test>
            <output>propulsion/tank[1]/mid-to-left-acc</output>
        </switch>
        
        <switch name="trash/propulsion/tank[1]/mid-to-right-acc">
            <default value="0"/>
            <test logic="AND" value="systems/fuel/left-boost-pressure">
                systems/fuel/right-lpcock == 1
                systems/fuel/xfeed == 1
                propulsion/tank[1]/pct-full gt 0.5
                propulsion/tank[11]/contents-lbs lt 1.0
            </test>
            <output>propulsion/tank[1]/mid-to-right-acc</output>
        </switch>
        
        <!-- aft to accumulators -->
        <switch name="trash/propulsion/tank[2]/aft-to-left-acc">
            <default value="0"/>
            <test logic="AND" value="systems/fuel/right-boost-pressure">
                systems/fuel/left-lpcock == 1
                systems/fuel/xfeed == 1
                propulsion/tank[2]/pct-full gt 0.5
                propulsion/tank[10]/contents-lbs lt 1.0
            </test>
            <output>propulsion/tank[2]/aft-to-left-acc</output>
        </switch>
        
        <switch name="trash/propulsion/tank[2]/aft-to-right-acc">
            <default value="0"/>
            <test logic="AND" value="systems/fuel/right-boost-pressure">
                systems/fuel/right-lpcock == 1
                propulsion/tank[2]/pct-full gt 0.5
                propulsion/tank[11]/contents-lbs lt 1.0
            </test>
            <output>propulsion/tank[2]/aft-to-right-acc</output>
        </switch>

        <!-- left wing drop tank to main -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 0
                propulsion/tank[8]/pct-full gt 0.5
                propulsion/tank[1]/pct-full lt 99.5
                systems/fuel/fore-transfer-valve == 1
            </test>
            <output>propulsion/tank[8]/left-drop-to-fore</output>
        </switch>

        <!-- left wing drop tank to aft -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 0
                propulsion/tank[8]/pct-full gt 0.5
                propulsion/tank[2]/pct-full lt 99.5
                systems/fuel/aft-transfer-valve == 1
            </test>
            <output>propulsion/tank[8]/left-drop-to-aft</output>
        </switch>

        <!-- right wing drop tank to fore -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 0
                propulsion/tank[9]/pct-full gt 0.5
                propulsion/tank[1]/pct-full lt 99.5
                systems/fuel/fore-transfer-valve == 1
            </test>
            <output>propulsion/tank[9]/right-drop-to-fore</output>
        </switch>

        <!-- right wing drop tank to aft -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 0
                propulsion/tank[9]/pct-full gt 0.5
                propulsion/tank[2]/pct-full lt 99.5
                systems/fuel/aft-transfer-valve == 1
            </test>
            <output>propulsion/tank[9]/right-drop-to-aft</output>
        </switch>

        
        <!-- center to fore -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 1
                propulsion/tank[7]/pct-full gt 0.5
                propulsion/tank[1]/pct-full lt 99.5
                systems/fuel/fore-transfer-valve == 1
            </test>
            <output>propulsion/tank[7]/center-to-fore</output>
        </switch>
        <!-- center to aft -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 1
                propulsion/tank[7]/pct-full gt 0.5
                propulsion/tank[2]/pct-full lt 99.5
                systems/fuel/aft-transfer-valve == 1
            </test>
            <output>propulsion/tank[7]/center-to-aft</output>
        </switch>

        <!-- transfer to fore/aft -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 2
                propulsion/tank[0]/pct-full gt 0.5
                propulsion/tank[1]/pct-full lt 99.5
                systems/fuel/fore-transfer-valve == 1
            </test>
            <output>propulsion/tank[0]/transfer-to-fore</output>
        </switch>

        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 2
                propulsion/tank[0]/pct-full gt 0.5
                propulsion/tank[2]/pct-full lt 99.5
                systems/fuel/aft-transfer-valve == 1
            </test>
            <output>propulsion/tank[0]/transfer-to-aft</output>
        </switch>

        <!-- wing left aft to fore/aft -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 2
                propulsion/tank[4]/pct-full gt 0.5
                propulsion/tank[1]/pct-full lt 99.5
                systems/fuel/fore-transfer-valve == 1
            </test>
            <output>propulsion/tank[4]/transfer-to-fore</output>
        </switch>

        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 2
                propulsion/tank[4]/pct-full gt 0.5
                propulsion/tank[2]/pct-full lt 99.5
                systems/fuel/aft-transfer-valve == 1
            </test>
            <output>propulsion/tank[4]/transfer-to-aft</output>
        </switch>


        <!-- wing right aft to fore/aft -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 2
                propulsion/tank[6]/pct-full gt 0.5
                propulsion/tank[1]/pct-full lt 99.5
                systems/fuel/fore-transfer-valve == 1
            </test>
            <output>propulsion/tank[6]/transfer-to-fore</output>
        </switch>

        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 2
                propulsion/tank[6]/pct-full gt 0.5
                propulsion/tank[2]/pct-full lt 99.5
                systems/fuel/aft-transfer-valve == 1
            </test>
            <output>propulsion/tank[6]/transfer-to-aft</output>
        </switch>

        <!-- wing left fore to fore/aft -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 3
                propulsion/tank[3]/pct-full gt 0.5
                propulsion/tank[1]/pct-full lt 99.5
                systems/fuel/fore-transfer-valve == 1
            </test>
            <output>propulsion/tank[3]/transfer-to-fore</output>
        </switch>

        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 3
                propulsion/tank[3]/pct-full gt 0.5
                propulsion/tank[2]/pct-full lt 99.5
                systems/fuel/aft-transfer-valve == 1
            </test>
            <output>propulsion/tank[3]/transfer-to-aft</output>
        </switch>

        <!-- wing right fore to fore/aft -->
        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 3
                propulsion/tank[5]/pct-full gt 0.5
                propulsion/tank[1]/pct-full lt 99.5
                systems/fuel/fore-transfer-valve == 1
            </test>
            <output>propulsion/tank[5]/transfer-to-fore</output>
        </switch>

        <switch>
            <default value="0"/>
            <test logic="AND" value="systems/fuel/pressure-flow">
                systems/fuel/stage_calc == 3
                propulsion/tank[5]/pct-full gt 0.5
                propulsion/tank[2]/pct-full lt 99.5
                systems/fuel/aft-transfer-valve == 1
            </test>
            <output>propulsion/tank[5]/transfer-to-aft</output>
        </switch>

<!--
    REFUELLING
-->

        <!-- determine flow rate for each tank -->
        <fcs_function>
            <function>
                <ifthen>
                    <le>
                        <property>systems/fuel/refuel-mode</property>
                        <value>1</value>
                    </le>
                    <!--TOT/INT-->
                    <quotient>
                        <property>systems/fuel/refuel-rate</property>
                        <sum>
                            <!--main group - refuel 1 and 2 if they're low-->
                            <lt>
                                <property>propulsion/tank[1]/pct-full</property>
                                <value>99.5</value>
                            </lt>
                            <lt>
                                <property>propulsion/tank[2]/pct-full</property>
                                <value>99.5</value>
                            </lt>
                            <!-- wing fwd - refuel 3 and 5 if they're low but 1 and 2 arent -->
                            <and>
                                <lt>
                                    <property>propulsion/tank[3]/pct-full</property>
                                    <value>99.5</value>
                                </lt>
                                <ge>
                                    <property>propulsion/tank[1]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[2]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                            </and>
                            <and>
                                <lt>
                                    <property>propulsion/tank[5]/pct-full</property>
                                    <value>99.5</value>
                                </lt>
                                <ge>
                                    <property>propulsion/tank[1]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[2]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                            </and>
                            <!-- forward trans + wing afts - refuel 0, 4 and 6 if they're low but 1, 2, 3, and 5 arent -->
                            <and>
                                <ge>
                                    <property>propulsion/tank[1]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[2]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[3]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[5]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <lt>
                                    <property>propulsion/tank[0]/pct-full</property>
                                    <value>99.5</value>
                                </lt>
                            </and>
                            <and>
                                <ge>
                                    <property>propulsion/tank[1]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[2]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[3]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[5]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <lt>
                                    <property>propulsion/tank[4]/pct-full</property>
                                    <value>99.5</value>
                                </lt>
                            </and>
                            <and>
                                <ge>
                                    <property>propulsion/tank[1]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[2]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[3]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[5]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <lt>
                                    <property>propulsion/tank[6]/pct-full</property>
                                    <value>99.5</value>
                                </lt>
                            </and>
                            <!-- center drop - refuel 7 after 0, 1, 2, 3, 4, 5 and 6 -->
                            <and>
                                <nq>
                                    <property>systems/fuel/refuel-mode</property>
                                    <value>1</value>
                                </nq>
                                <ge>
                                    <property>propulsion/tank[0]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[1]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[2]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[3]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[4]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[5]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[6]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <lt>
                                    <property>propulsion/tank[7]/pct-full</property>
                                    <value>99.5</value>
                                </lt>
                            </and>
                            <!-- wing drops - refuel 8 and 9 after 0, 1, 2, 3, 4, 5, 6 and 7 -->
                            <and>
                                <nq>
                                    <property>systems/fuel/refuel-mode</property>
                                    <value>1</value>
                                </nq>
                                <ge>
                                    <property>propulsion/tank[0]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[1]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[2]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[3]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[4]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[5]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[6]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <ge>
                                    <property>propulsion/tank[7]/pct-full</property>
                                    <value>99.5</value>
                                </ge>
                                <lt>
                                    <property>propulsion/tank[8]/pct-full</property>
                                    <value>99.5</value>
                                </lt>
                            </and>
                            <and>
                                <nq>
                                    <property>systems/fuel/refuel-mode</property>
                                    <value>1</value>
                                </nq>
                                <ge>
                                    <property>propulsion/tank[0]/pct-full</property>
