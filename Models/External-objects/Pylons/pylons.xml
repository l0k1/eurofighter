		<object-name>pylonFront.L</object-name>
		<object-name>pylonRear.L</object-name>
		<object-name>pylonFront.R</object-name>
		<object-name>pylonRear.R</object-name>
	</animation>
 
  <!-- pylon options
      _________________|_________|_________________
      \                |         |                /
       \               |         |               /
        \4.R           |         |           4.L/
         (12)          |RR    RL |          (11)
          \  3.R       |(10)  (8)|       3.L  /
           \ (5)       |         |       (2) /   
            \          |         |          /    
             \         |         |         /
       2fuel.R\  2.R   |RF    LF |   2.L  /2fuel.L
          (15) \ (4)   |(9)   (7)|   (1) / (13)
                \      |         |      /
                 \     |         |     /
                  \ 1.R|    C2   |1.L /
                   \(3)|   C14)  |(0)/
                    \  |    C    |  /
                     \ |   (6)   | /
                      \|_________|/
  -->
	<animation>
		<type>select</type>
		<object-name>pylon1.L</object-name>
		<condition>
			<not-equals>
				<property>sim/multiplay/generic/short[5]</property>
				<value>none</value>
			</not-equals>
		</condition>
	</animation>
